{block h1}
{_"Dashboard"}
{/block}

{block content}
<div class="container-fluid">
	<p class="lead"></p>
	<div class="card-body">
		<h4 class="card-title">{_"Welcome in"} Fire CMS</h4>
		<p class="card-text">{_"Here are some simple statistics."}</p>
	</div>
	<div class="row dashboard">
		<div class="col-lg-3 col-md-6">
			<div class="card card-inverse card-success">
				<div class="card-body text-center bg-success">
					<div class="rotate">
						<i class="fa fa-user fa-4x"></i>
					</div>
					<h6 class="card-title text-uppercase">{_"Users"}</h6>
					<h2 class="display-2">{$counts['users']}</h2>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-md-6">
			<div class="card card-inverse card-danger">
				<div class="card-body text-center bg-danger">
					<div class="rotate">
						<i class="fa fa-list fa-4x"></i>
					</div>
					<h6 class="card-title text-uppercase">{_"Posts"}</h6>
					<h2 class="display-2">{$counts['articles']}</h2>
				</div>
			</div>
		</div>
		<div class="col-lg-6 col-md-12">
			<div class="card card-inverse card-info">
				<div class="card-body text-center bg-info">
					<div class="rotate">
						<i class="fa fa-calendar fa-4x"></i>
					</div>
					<h6 class="card-title text-uppercase">{_"Site traffic"}</h6>
					<h2 class="display-2">&Oslash;&nbsp;{$counts['statistics']}</h2>
				</div>
			</div>
		</div>
		{*<div class="col-lg-3 col-md-6">
			<div class="card card-inverse card-warning">
				<div class="card-body text-center bg-warning">
					<div class="rotate">
						<i class="fa fa-share fa-4x"></i>
					</div>
					<h6 class="card-title text-uppercase">Shares</h6>
					<h1 class="display-2">36</h1>
				</div>
			</div>
		</div>*}
	</div>
