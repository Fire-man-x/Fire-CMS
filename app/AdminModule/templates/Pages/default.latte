{block h1}
{_"Pages"}
{/block}

{block buttons}
	<a n:if="$user->isAllowed('Pages', 'edit')" n:href="detail id=>null" class="btn btn-primary"><i class="fa fa-plus"></i> {_'Add'}</a>
{/block}

{block content}
	{snippet pagesGrid}
		{define icon-arrows-v}
			<i class="fas fa-arrows-alt-v"></i>
		{/define}
		{control pagesGrid}
	{/snippet}
{/block}
