{*
 * BreadCrumb Template
 *
 * @author David Zadrazil <me@davidzadrazil.cz>
 *}

<nav aria-label="breadcrumb">
	<ol class="breadcrumb">
		<li n:foreach="$links as $link" class="breadcrumb-item {if !$link['link'] || $iterator->isLast()}active{/if}" {if $iterator->isLast()}aria-current="page"{/if}>
			<i class="{$link['icon']}" n:if="$link['icon']"></i>
			<a n:tag-if="$link['link'] && !$iterator->isLast()" href="{$link['link']}" title="{$link['title']}">{$link['title']}</a>
			{*<i class="fa fa-angle-right" n:if="!$iterator->isLast()"></i>*}
		</li>
	</ol>
</nav>
