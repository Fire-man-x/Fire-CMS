{block h1}
	{$options['main_title']}
{/block}

{block content}

	{control pluginSlider main_menu}

	<!-- Post Content -->
	<article>
		{$category->content|noescape}

		<p class="post-meta">{_"Posted by <a href='%s'>%s</a> on %s", "#",$category->author['author'], $category->publishingDate->format(\DATETIME_FORMAT) |noescape} {_'viewed'} {$category->viewCount}</p>
	</article>

	{control articles $category->categoryId}