{
  "name": "aleswita/visualpaginator",
  "description": "VisualPaginator for Nette Framework.",
  "type": "library",
  "keywords": [
    "nette",
    "visual paginator",
    "paginator"
  ],
  "license": ["MIT"],
  "homepage": "https://github.com/aleswita/VisualPaginator",
  "authors": [
    {
      "name": "Ales Wita"
    }
  ],
  "require": {
    "php": "^8.3",
    "nette/application": "^3.2",
    "nette/component-model": "^3.1|^4.0",
    "nette/forms": "^3.2",
    "nette/http": "^3.3",
    "nette/utils": "^4.0",
    "latte/latte": "^3.0"
  },
  "require-dev": {
    "nette/bootstrap": "^3.2",
    "nette/di": "^3.2",
    "nette/robot-loader": "^4.0",
    "nette/tester": "^2.5",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-nette": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "tracy/tracy": "^2.10"
  },
  "autoload": {
    "psr-4": {
      "AlesWita\\VisualPaginator\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\": "tests/App",
      "Tests\\": "tests/tests"
    }
  },
  "config": {
    "sort-packages": true
  }
}
